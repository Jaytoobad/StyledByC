{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/expire",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/images/:path*", "destination": "/images/:path*" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/api/admin/auth/:action", "destination": "/api/admin/auth?action=:action" },
    { "source": "/api/pay/verify", "destination": "/api/pay?action=verify" },
    { "source": "/api/pay/:ref", "destination": "/api/pay?ref=:ref" },
    { "source": "/api/admin/bookings-details", "destination": "/api/admin/bookings?action=details" },
    { "source": "/api/cron/reminders", "destination": "/api/cron/expire?action=reminders" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}