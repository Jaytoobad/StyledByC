# Copy this file to .env.local and replace placeholders locally.
# Never commit .env.local or put server secrets in VITE_* variables.

# Required for the browser payment flow (safe to expose; public key only).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Optional browser monitoring.
VITE_SENTRY_DSN=

# Server-only settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PAYSTACK_SECRET_KEY=sk_test_replace_me
CRON_SECRET=replace_with_a_long_random_secret

# Configure these owner contact details before enabling production notifications.
STUDIO_PHONE=
OWNER_PHONE=
OWNER_EMAIL=
OWNER_PASSWORD=

# SMS_MODE=stub never contacts the SMS provider.
# Use live only after confirming the provider endpoint, credentials, and sender ID.
SMS_MODE=stub
SMS_API_URL=https://sms.sasusync.com/api/v1/send
SASUSYNC_API_KEY=
SMS_SENDER_ID=StyledByC

# Optional SMS settings. Sandbox mode requires SMS_SANDBOX_URL.
SMS_AUTH_HEADER=X-API-Key
SMS_SANDBOX_URL=
