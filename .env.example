# Frontend variables only. Never put Paystack secret keys, Google credentials,
# or email API secrets here.
#
# Paystack public key for frontend (Vite env variable)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Sentry DSN (frontend)
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Backend / server-only variables (set in hosting platform, NEVER in .env.example
# with real values). Required for deployment:
# ---------------------------------------------------------------------------

# Neon Postgres connection string (used by drizzle-orm and @neondatabase/serverless)
DATABASE_URL=postgresql://user:password@host:5432/db

# SASUSYNC SMS API key (server-only, used by api/_lib/sms.ts)
SASUSYNC_API_KEY=sk_live_xxxxx

# SMS sender ID
SMS_SENDER_ID=StyledByC

# SMS mode: 'live' or 'sandbox'
SMS_MODE=sandbox

# Studio phone number (Ghana format, e.g. 233200000000) for SMS alerts
STUDIO_PHONE=233200000000

# Owner phone for payment-needs-attention alerts
OWNER_PHONE=233200000000

# Cron secret for securing /api/cron/expire and /api/cron/reminders
# Must match the value configured in your cron provider (e.g. Vercel Cron)
CRON_SECRET=changeme-cron-secret

# Paystack secret key (server-only, used by api/paystack/webhook.ts and src/lib/paystack-verify.ts)
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Owner email for seed / password reset scripts
OWNER_EMAIL=your-admin-email@example.com

# Owner password for seed / password reset scripts
OWNER_PASSWORD=changeme-owner-password
