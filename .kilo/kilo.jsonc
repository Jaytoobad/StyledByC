{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "70000000000000000000000000000000000000000000000"
      }
    },
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp?readonly=true"
    }
  }
}